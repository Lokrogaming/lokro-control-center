# =============================================================================
# LOKRO Server Control Center - Nginx Reverse-Proxy
# Installieren Sie diese Datei als /etc/nginx/sites-available/lokro-control-center
# und aktivieren Sie sie mit einem Symlink in /etc/nginx/sites-enabled/.
# DIESE DATEI UEBERSCHRIEBT NICHT EXISTIERENDE KONFIGURATIONEN.
# =============================================================================

# HTTP -> Weiterleitung auf HTTPS (außer Let's Encrypt Challenge)
server {
    listen 80;
    listen [::]:80;
    server_name server.lokro.dev;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name server.lokro.dev;

    # Let's Encrypt / Certbot Zertifikate (durch install.sh erstellt)
    ssl_certificate     /etc/letsencrypt/live/server.lokro.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server.lokro.dev/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Sicherheitsheader
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Reverse Proxy zum Go-Backend (laeuft auf 127.0.0.1:8080)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Health-Check direkt (ohne Proxy-Header-Erweiterung optional)
    location = /health {
        proxy_pass http://127.0.0.1:8080;
        access_log off;
    }
}
