# =============================================================================
# LOKRO Server Control Center - Umgebungsvariablen
# Kopieren Sie diese Datei nach /opt/lokro-control-center/.env und passen Sie
# die Werte an. Führen Sie danach `sudo systemctl restart lokro-control-center` aus.
# =============================================================================

# Allgemein
APP_ENV=production
APP_PORT=8080
APP_HOST=127.0.0.1

# Speicher (JSON-Datei im Standard; später "sqlite" / "postgres")
DATABASE_URL=/opt/lokro-control-center/data/lokro.json
DATABASE_DRIVER=json

# Session / Authentifizierung
# WICHTIG: Erzeugen Sie einen geheimen Wert, z. B.:
#   openssl rand -hex 32
SESSION_SECRET=ersetzen_sie_durch_ein_geheimes_32_Byte_Hex
SESSION_DURATION=24h
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Passwort-Hashing (PBKDF2-HMAC-SHA256, stdlib)
PBKDF2_ITERATIONS=200000

# Sicherheitsrichtlinien
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION=15m

# Monitoring
METRICS_INTERVAL=5s
METRICS_RETENTION=72h
ANALYTICS_RETENTION=90d
ANONYMIZE_IP=true

# Server
SERVER_NAME=LOKRO Server Control Center

# Optionale Features
DOCKER_ENABLED=false

# Benachrichtigungen (zukünftige Phasen - Platzhalter)
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Pterodactyl-Datenbank (MySQL/MariaDB) für späteren SQL-Betrieb.
# Der Standard-Betrieb nutzt den integrierten JSON-Store (keine externen Treiber nötig).
# PTERODACTYL_DB_HOST=
# PTERODACTYL_DB_PORT=3306
# PTERODACTYL_DB_NAME=lokro
# PTERODACTYL_DB_USER=lokro
# PTERODACTYL_DB_PASS=
